# =============================================================================
# Veyon AI Monitor — environment configuration
# =============================================================================
# If this file does not exist, the app auto-creates it on first run with a
# random STORAGE_SECRET and default admin/admin credentials.
#
# To customise, copy this file to `.env` and edit the values you need.
# `.env` is .gitignored — never commit it.
#
# Settings priority (highest wins):
#   UI /settings page  >  .env (VEYON_* vars)  >  built-in defaults
# =============================================================================

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------

# Signs NiceGUI session cookies. Auto-generated if .env is missing.
# To rotate: python -c "import secrets; print(secrets.token_urlsafe(48))"
STORAGE_SECRET=replace-with-output-of-secrets.token_urlsafe(48)

# Initial admin account — used only when the database has no users yet.
# After the first login, change the password through the UI.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Login rate limiting
# -----------------------------------------------------------------------------

# Failed logins are counted per client IP AND per username. After
# LOGIN_MAX_ATTEMPTS failures within LOGIN_WINDOW_SEC seconds on either
# counter, further attempts are rejected until the oldest failure ages out
# of the window. A successful login resets both counters, and counters
# reset on app restart (they are in-memory).
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW_SEC=300

# -----------------------------------------------------------------------------
# Password policy
# -----------------------------------------------------------------------------

# Minimum length for passwords set through the UI (create user, activate
# student, change password). Enforced server-side. Changing it does not
# affect existing passwords — only newly set ones. Requires restart.
#PASSWORD_MIN_LENGTH=8

# -----------------------------------------------------------------------------
# Web server binding
# -----------------------------------------------------------------------------

# Interface the web UI listens on. The default 0.0.0.0 makes the app reachable
# from other machines on the LAN (the normal classroom deployment). Set to
# 127.0.0.1 to restrict access to this machine only (e.g. behind a reverse
# proxy that terminates TLS).
#BIND_HOST=0.0.0.0
#BIND_PORT=8080

# -----------------------------------------------------------------------------
# TLS / HTTPS
# -----------------------------------------------------------------------------

# Serve the UI over HTTPS so session cookies and screen captures are encrypted
# on the LAN. On first start a self-signed certificate is generated at
# data/tls/cert.pem + key.pem — browsers show a one-time "connection is not
# private" warning for it (click Advanced → Proceed, or import cert.pem into
# the client machines' trusted store to silence it). To use an
# institution-issued certificate instead, point the two paths at it.
#TLS_ENABLED=false
#TLS_CERTFILE=data/tls/cert.pem
#TLS_KEYFILE=data/tls/key.pem

# -----------------------------------------------------------------------------
# Application defaults  (uncomment and edit to override)
# -----------------------------------------------------------------------------

# Authentication
#VEYON_AUTH_METHOD=key          # key | logon
#VEYON_KEY_NAME=class
#VEYON_KEY_PATH=class.pem
#VEYON_LOGON_USERNAME=

# Veyon CLI
#VEYON_CLI=C:\Program Files\Veyon\veyon-cli.exe

# WebAPI server
#VEYON_HOST=localhost
#VEYON_PORT=11080
#VEYON_AUTO_START=true            # true | false
#VEYON_START_WAIT=10              # seconds to wait after starting WebAPI

# Capture
#VEYON_INTERVAL=1                 # seconds between screenshots
#VEYON_IMG_FMT=jpeg               # jpeg | png
#VEYON_IMG_QUALITY=85             # 1-100
#VEYON_IMG_WIDTH=1920             # pixels

# Detection
#VEYON_DETECT_CONF=0.40
#VEYON_DETECT_IOU=0.20
#VEYON_KEEP_TOP1=False            # keep top-1 detection per class only

# Detection performance
#VEYON_BATCH_MAX_CUDA=32          # max frames per inference call on GPU
#VEYON_BATCH_MAX_CPU=16           # max frames per inference call on CPU
#VEYON_DETECT_CYCLE_TIMING=False  # log full capture→detection latency to CSV

# Alerts
#VEYON_ALERT_THRESHOLD=1          # repeated detections in a row per class to trigger an alert

# Data retention
#VEYON_RETENTION_DAYS=0           # permanently delete events older than N days (0 = keep forever)
